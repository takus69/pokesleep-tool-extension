{
  "name": "pokesleep-tool-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.3.2",
    "@mui/material": "^7.3.2",
    "@react-spring/web": "^10.0.3",
    "@use-gesture/react": "^10.3.1",
    "i18next": "^25.5.3",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-i18next": "^16.0.0"
  },
  "scripts": {
    "build": "vite build && node scripts/verify-dist-notices.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "sync:upstream-data": "node scripts/sync-upstream-data.mjs",
    "release:prepare": "npm run sync:upstream-data && npm run verify",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.13",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "4.4.1",
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.5.0",
    "jsdom": "26.1.0",
    "typescript": "^5.9.2",
    "vite": "6.4.3",
    "vitest": "3.2.7",
    "yaml": "2.9.1"
  }
}
